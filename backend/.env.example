# =============================================================================
# FanIQ — variabili d'ambiente
# Copia in .env e compila i valori
# =============================================================================

# DATABASE
# Locale (SQLite): FANIQ_DATABASE_URL=sqlite:///./faniq.db
# Produzione (Neon): postgresql://neondb_owner:PWD@ep-XXX.neon.tech/neondb?sslmode=require
FANIQ_DATABASE_URL=sqlite:///./faniq.db

# JWT — genera con: openssl rand -hex 32
FANIQ_JWT_SECRET=CAMBIA-QUESTO-VALORE
FANIQ_JWT_EXPIRE_MINUTES=10080

# CORS (frontend URL, virgola-separati)
FANIQ_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload
FANIQ_MAX_UPLOAD_MB=20

# Chat AI (opzionale)
OPENAI_API_KEY=
FANIQ_OPENAI_MODEL=gpt-4o
FANIQ_CHAT_MAX_TURNS=6
FANIQ_CHAT_MAX_TOKENS=2048
FANIQ_CHAT_ANONYMIZE=true

# Performance
FANIQ_CACHE_TTL=120

# Logging
FANIQ_LOG_LEVEL=INFO
